{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PlatformIO: Build and flash stable release",
      "type": "process",
      "command": "${env:USERPROFILE}\\.platformio\\penv\\Scripts\\platformio.exe",
      "args": [
        "run",
        "-e",
        "esp32s3_devkit_release",
        "-t",
        "upload"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "PlatformIO: Flash cached stable release (fast)",
      "type": "process",
      "command": "${env:USERPROFILE}\\.platformio\\penv\\Scripts\\platformio.exe",
      "args": [
        "run",
        "-e",
        "esp32s3_devkit_release",
        "-t",
        "nobuild",
        "-t",
        "upload"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
